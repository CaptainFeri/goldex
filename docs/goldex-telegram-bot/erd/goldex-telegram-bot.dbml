Project goldex-telegram-bot {
  database_type: 'PostgreSQL'
  Note: 'Auto-generated from TypeORM entities (tools/generate-erd-dbml.js). Import to dbdiagram.io'
}

Table telegram_users {
  id uuid
  telegram_chat_id int8 [unique]
  phone varchar(15)
  goldex_user_id varchar
  access_token text
  refresh_token text
  state varchar(30) [default: 'idle']
  first_name varchar(100)
  last_name varchar(100)
  username varchar(100)
  last_activity_at timestamptz
  is_channel_admin boolean [default: 'false']
  role int
  metadata jsonb
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

