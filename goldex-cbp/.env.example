PORT=4100

PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5434
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=postgres
PAYMENT_DB_NAME=payment-db
PAYMENT_DB_SYNC=true

# Callback URL handed to the Kaino IPG — must be PUBLICLY reachable.
# Kaino redirects the payer's browser here; goldex-backend proxies it to this
# service (backend route: /api/v1/payments/callbacks/kaino).
PAYMENT_CALLBACK_BASE_URL=http://91.228.186.110:4040

# ── RabbitMQ (integration with goldex-backend) ─
CBP_RABBITMQ_HOST=localhost
CBP_RABBITMQ_PORT=5672
CBP_RABBITMQ_USER=guest
CBP_RABBITMQ_PASS=guest
CBP_RABBITMQ_EXCHANGE=signalr.providers
CBP_RABBITMQ_QUEUE=goldex.cbp.queue

# ── Kaino Wallet ─────────────────────────────
KAINO_BASE_URL=https://wallet.kaino.ir
KAINO_USERNAME=your_username
KAINO_PASSWORD=your_password
KAINO_TENANT=TENANT001
KAINO_SECRET=your_hmac_secret
KAINO_PAYER_MOBILE=
# Path of the Kaino IPG payment page (the user is redirected here to pay).
# The gateway redirect URL becomes {KAINO_BASE_URL}{KAINO_IPG_PAY_PATH}?reference={ipgReference}
KAINO_IPG_PAY_PATH=/rest/channel/wallet/v1/chargeWallet/pay

# ── Shahin (Pars Zargar) RIAL payout gateway ─
SHAHIN_SERVICE_URL=http://91.212.174.157:3200
SHAHIN_SERVICE_API_KEY=
SHAHIN_REQUEST_TIMEOUT=60000
SHAHIN_BANK_CODE=BKV
SHAHIN_COMPANY_NATIONAL_CODE=
SHAHIN_SOURCE_ACCOUNT=
# Shahin uses its own Iran egress proxy (separate from Kaino).
SHAHIN_PROXY_HOST=91.212.174.157
SHAHIN_PROXY_PORT=29180
SHAHIN_PROXY_USERNAME=
SHAHIN_PROXY_PASSWORD=

# ── Outbound gateway proxy (Iran egress) ─────
# Routes Kaino gateway calls through the Iranian proxy so they originate
# from an Iranian IP. Leave CBP_PROXY_HOST empty to disable.
CBP_PROXY_HOST=185.8.174.29
CBP_PROXY_PORT=29180
CBP_PROXY_USERNAME=
CBP_PROXY_PASSWORD=
