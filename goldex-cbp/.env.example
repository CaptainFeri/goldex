PORT=4100

PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5434
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=postgres
PAYMENT_DB_NAME=payment-db
PAYMENT_DB_SYNC=true

# Callback URL handed to the Kaino IPG — must be PUBLICLY reachable.
# Kaino redirects the payer's browser here; goldex-backend proxies it to this
# service (backend route: /api/v1/payments/callbacks/kaino).
PAYMENT_CALLBACK_BASE_URL=http://91.228.186.110:4040

# ── RabbitMQ (integration with goldex-backend) ─
CBP_RABBITMQ_HOST=localhost
CBP_RABBITMQ_PORT=5672
CBP_RABBITMQ_USER=guest
CBP_RABBITMQ_PASS=guest
CBP_RABBITMQ_EXCHANGE=signalr.providers
CBP_RABBITMQ_QUEUE=goldex.cbp.queue

# ── Kaino Wallet ─────────────────────────────
KAINO_BASE_URL=https://wallet.kaino.ir
KAINO_USERNAME=your_username
KAINO_PASSWORD=your_password
KAINO_TENANT=TENANT001
KAINO_SECRET=your_hmac_secret
KAINO_PAYER_MOBILE=
