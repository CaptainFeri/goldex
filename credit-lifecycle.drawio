<mxfile host="app.diagrams.net" agent="opencode" version="24.0.0">
  <diagram id="credit-lifecycle" name="Credit Lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== Start ===================== -->
        <mxCell id="req" value="User: Request Credit Facility&lt;br&gt;&lt;i&gt;freeze collateral → issue leveraged line&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="acreate" value="Admin: Create Credit (v1)&lt;br&gt;&lt;i&gt;credit line + freeze material&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Active ===================== -->
        <mxCell id="active" value="Credit ACTIVE&lt;br&gt;&lt;i&gt;line issued · collateral frozen&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Actions ===================== -->
        <mxCell id="trade" value="Trade&lt;br&gt;&lt;i&gt;credit BUY / SELL orders&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="settle_admin" value="Admin Settle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="330" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="self_settle" value="User Self-Settle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="490" y="330" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="workflow" value="Delivery Settlement Workflow&lt;br&gt;&lt;i&gt;approve → valuate → fund → deliver → clear&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="710" y="330" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="suspend" value="Suspend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="990" y="330" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cancel" value="Cancel&lt;br&gt;&lt;i&gt;no open trades&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="liquidate" value="Liquidate&lt;br&gt;&lt;i&gt;margin call / drawdown / expiry&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="270" y="470" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Terminals ===================== -->
        <mxCell id="settled" value="SETTLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="600" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cancelled" value="CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rejected" value="REJECTED&lt;br&gt;&lt;i&gt;admin declines settlement&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="470" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="suspended" value="SUSPENDED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="470" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Edges ===================== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="req" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="acreate" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="place order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="active" target="trade">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="order completed / cancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="trade" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="active" target="settle_admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="active" target="self_settle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="active" target="workflow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="active" target="suspend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="no open trades" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="active" target="cancel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="risk breach" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="active" target="liquidate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="settle_admin" target="settled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="self_settle" target="settled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="liability cleared" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="workflow" target="settled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="admin reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="workflow" target="rejected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="liquidate" target="settled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cancel" target="cancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="suspend" target="suspended">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="reactivate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="suspended" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
