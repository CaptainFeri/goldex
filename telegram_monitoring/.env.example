# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=+1234567890

# Optional: 2FA password
TELEGRAM_PASSWORD=

# Optional: Session persistence
# After first auth, save the session string from logs and set it here
# to avoid re-authentication on every restart
TELEGRAM_SESSION_STRING=

# Optional: Session folder for StoreSession (default: sessions)
TELEGRAM_SESSION_FOLDER=sessions

# Channels/groups to monitor (comma-separated, supports numeric IDs or @usernames)
# For channels from web.telegram.org use the numeric ID (e.g. -1001718390832)
TELEGRAM_MONITORED_CHANNELS=-1001718390832

# Target channel to share messages to (numeric ID or @username)
TELEGRAM_TARGET_CHANNEL=

# Robot wallet report channel — orders, wallet status, and profits are posted
# here as simulated (paper) trades (numeric ID or @username)
TELEGRAM_WALLET_REPORT_CHANNEL=-1004328070819

# --- Redis ---

# Redis connection (``docker compose up`` provides these at defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Price chart / arbitrage ---

# HTTP port for the price chart UI + API (default: 3000)
PORT=3000

# Minimum per-unit profit (spread) to alert on, in Toman (default: 80000)
ARBITRAGE_MIN_PROFIT=80000

# How far back (seconds) buy/sell prices may be compared for arbitrage (default: 600 = 10 min)
ARBITRAGE_WINDOW_SECONDS=600

# How long a reported (buy/sell) price pair is remembered before it can alert
# again (default: same as ARBITRAGE_WINDOW_SECONDS)
ARBITRAGE_REPORT_TTL_SECONDS=600

# QuickChart endpoint used to render the chart image attached to alerts.
# Default is the public service; self-host for privacy:
#   docker run -p 3400:3400 ianw/quickchart  ->  QUICKCHART_URL=http://localhost:3400
QUICKCHART_URL=https://quickchart.io

# Redis TTL for price points in seconds (default: 86400 = 24h)
PRICE_TTL=86400

# Redis TTL for arbitrage records in seconds (default: 604800 = 7d)
ARBITRAGE_TTL=604800

# --- Robot wallet (paper trading) ---

# Initial IRR balance of the shared wallet pool in Toman (default: 100000000000
# — sized so the robot can hold several kg at current channel prices)
WALLET_INITIAL_IRR=100000000000

# Initial gold balance per symbol wallet in kilograms (default: 1)
WALLET_INITIAL_GOLD_KG=1

# Fraction of total assets (cash + gold cost basis) always kept as cash.
# Buys are sized so this floor is never spent (default: 0.2 = 20%)
WALLET_CASH_RESERVE_RATIO=0.2

# Smallest position in kilograms the wallet opens when sizing down a signal
# (default: 1)
WALLET_MIN_TRADE_KG=1

# Redis TTL for wallet trade records in seconds (default: 604800 = 7d)
WALLET_TTL=604800

# Only trade signals of this delivery type, within the normal sub-type
# (default: با حواله). Other delivery types are ignored by the wallet.
WALLET_DELIVERY_TYPE=با حواله

# Post the wallet Excel file (status + orders) to the report channel at the
# top of every hour (1:00, 2:00, ...). Set to false to disable (default: true)
WALLET_HOURLY_EXCEL=true

# How often the robot posts the overall wallet status (balances + P/L) to the
# report channel, in seconds (default: 60 = every minute)
WALLET_STATUS_INTERVAL_SECONDS=60
