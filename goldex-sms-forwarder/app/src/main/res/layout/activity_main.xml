<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <!-- Screen 1: Provider List -->
    <LinearLayout
        android:id="@+id/providerListScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_primary"
            app:title="Provider Auth"
            app:titleTextColor="@android:color/white"
            app:menu="@menu/top_app_bar_menu" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:background="@color/md_theme_background">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pricingEngineUrlLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pricing Engine URL"
                app:endIconMode="clear_text"
                app:boxStrokeWidth="1.5dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pricingEngineUrlEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refreshProvidersButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Load Providers"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/providerList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="16dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/emptyListText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No providers found.\nEnter the Pricing Engine URL and tap Load Providers."
            android:textSize="16sp"
            android:textColor="@color/md_theme_on_surface_variant"
            android:visibility="gone"
            android:lineSpacingExtra="4dp" />

        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            style="?android:attr/progressBarStyle" />

    </LinearLayout>

    <!-- Screen 2: Provider Config + WebView -->
    <FrameLayout
        android:id="@+id/configScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/configFormContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/configToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md_theme_primary"
                app:title="Configure Provider"
                app:titleTextColor="@android:color/white"
                app:navigationIcon="?attr/homeAsUpIndicator" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Provider Phone Number"
                        app:boxStrokeWidth="1.5dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:importantForAutofill="no" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Provider Name (e.g. \u0645\u06CC\u0631\u0631\u06A9\u0646\u06CC)"
                        app:boxStrokeWidth="1.5dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/providerNameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:importantForAutofill="no" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="SMS must contain this name for OTP auto-capture"
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_on_surface_variant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Provider Panel Login URL"
                        app:boxStrokeWidth="1.5dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginUrlEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:importantForAutofill="no" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Backend URL (where auth data is forwarded)"
                        app:boxStrokeWidth="1.5dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/backendUrlEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:importantForAutofill="no" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Provider Type"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_on_surface" />

                    <RadioGroup
                        android:id="@+id/providerTypeRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/providerTypeZaryar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Zaryar" />

                        <RadioButton
                            android:id="@+id/providerTypeTalaab"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TalaAb" />

                    </RadioGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launchPanelButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Launch Provider Panel"
                        android:icon="@android:drawable/ic_menu_compass"
                        style="@style/Widget.Material3.Button" />

                    <TextView
                        android:id="@+id/authStatusLog"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:background="@color/status_log_bg"
                        android:text="Ready"
                        android:gravity="top"
                        android:textSize="13sp"
                        android:typeface="monospace"
                        android:textColor="@color/md_theme_on_surface"
                        android:scrollbars="vertical" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <WebView
            android:id="@+id/providerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
