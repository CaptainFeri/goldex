  type SystemLedgerType
  amount decimal(20,8)
  order_id uuid
  user_id uuid
  provider_key varchar
  description varchar
  created_at timestamptz
  indexes {
    (symbol_id, created_at)
  }
}

Table ticket_messages {
  id uuid
  ticket_id varchar
  sender_id varchar
  sender_type enum
  message text
  attachments jsonb
  is_internal boolean [default: 'false']
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table transaction {
  id uuid
  wallet_id varchar
  order_id uuid
  transaction_id varchar(100) [unique]
  transaction_type TransactionTypeEnum
  status TransactionStatusEnum [default: 'pending']
  amount decimal(20,8)
  fee decimal(20,8) [default: 0]
  price decimal(20,8)
  description text
  metadata jsonb
  completed_at timestamp
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user {
  id uuid
  first_name varchar
  last_name varchar
  password varchar
  email varchar
  email_verified_at timestamp
  two_factor_activated_at timestamp
  registered_at timestamp
  blocked_at timestamp
  active_until timestamp
  role int [default: 'NEW_USER']
  two_factor_secret varchar
  two_factor_url varchar
  is_authenticated_by_google boolean [default: 'false']
  referral_code varchar
  phone varchar
  referral_id varchar
  level_id varchar
  level_assigned_at timestamptz
  level_expires_at timestamptz
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
  profile_id uuid
}

Table user_2fa_setting {
  id int
  withdrawal_activated_at timestamp
  login_activated_at timestamp
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
  user_id uuid
}

Table user_bank_account {
  id uuid
  iban varchar
  bank_name varchar
  deposit_number varchar
  user_id varchar [unique]
  verified_at timestamp
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_device {
  id uuid
  ip_address varchar
  device_id varchar
  device_type varchar
  user_agent varchar
  last_login timestamp
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
  user_id uuid
}

Table user_kyc {
  id uuid
  user_id varchar [unique]
  national_id varchar
  birth_date varchar
  level int [default: 0]
  status int [default: 0]
  verified_at timestamp
  reject_reason varchar
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_kyc_history {
  id uuid
  userId varchar
  level int [default: 0]
  status int [default: 0]
  reason varchar
  created_at timestamptz
  user_id uuid
}

Table user_level {
  id uuid
  name varchar(100) [unique]
  slug varchar(100) [unique]
  description text
  priority int [default: 0]
  is_default boolean [default: 'false']
  features jsonb [default: '{}']
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_login_history {
  id uuid
  status int
  ip_address varchar
  user_id varchar
  device_info varchar
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_market_kinds {
  id uuid
  user_id uuid
  market_kind MarketKindEnum
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_market_types {
  id uuid
  user_id uuid
  market_type MarketTypeEnum
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_profile {
  id uuid
  avatar_img_path varchar
  postal_code varchar
  address varchar
  gender int [default: 'NOT_SET']
  country_id int
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_refresh_token {
  id int
  token varchar
  expired_at timestamp
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
  user_id uuid
  device_id uuid
}

Table user_setting {
  id int
  user_id varchar
  default_language_id int [default: 'English']
  is_email_notification_enabled boolean [default: 'false']
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table user_telegram {
  id uuid
  telegram_id int8 [unique]
  user_id varchar
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table wallet {
  id uuid
  user_id varchar
  symbol_id varchar
  free_balance decimal(20,8) [default: 0]
  locked_balance decimal(20,8) [default: 0]
  status WalletStatusEnum [default: 'ACTIVE']
  frozen_free_balance decimal(20,8) [default: 0]
  frozen_locked_balance decimal(20,8) [default: 0]
  frozen_at timestamp
  admin_note text
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table warehouse {
  id uuid
  name varchar(255)
  description text
  location varchar(255)
  capacity_total decimal(20,8) [default: 0]
  capacity_used decimal(20,8) [default: 0]
  capacity_remaining decimal(20,8) [default: 0]
  delivery_dates jsonb
  delivery_schedule jsonb
  time_limit varchar(100)
  status WarehouseStatusEnum [default: 'ACTIVE']
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table warehouse_history {
  id int
  warehouse_id uuid
  packet_id uuid
  request_id uuid
  action varchar(100)
  description text
  performed_by varchar(100)
  performed_role varchar(50)
  metadata jsonb
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table warehouse_request {
  id uuid
  type RequestTypeEnum
  status RequestStatusEnum [default: 'PENDING']
  user_id uuid
  packet_id uuid
  warehouse_id uuid
  admin_id uuid
  weight decimal(20,8)
  symbol_id uuid
  delivery_date timestamptz
  delivery_time varchar(100)
  delivery_location varchar(500)
  notes text
  processed_at timestamptz
  metadata jsonb
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table withdraw {
  id uuid
  user_id varchar
  symbol_id varchar
  type varchar
  amount decimal(20,8)
  status WithdrawStatusEnum [default: 'PENDING']
  admin_id varchar
  notes varchar
  picture_path varchar
  metadata jsonb
  gateway_code varchar
  completed_at timestamp
  warehouse_request_id uuid
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

