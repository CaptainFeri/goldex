}

Table shahin_accounts {
  id int
  userId varchar
  accountNumber varchar(50)
  iban varchar(50)
  ownerName varchar(100)
  bankName varchar(100)
  bankCode varchar(10)
  nationalCode varchar(20)
  balance decimal(18,2)
  accountStatus varchar(20) [default: 'active']
  accountType varchar(20)
  lastAccessedAt timestamp
  createdAt timestamptz
  updatedAt timestamptz
  metadata jsonb
  indexes {
    (accountNumber, bankCode) [unique]
  }
}

Table shahin_entries {
  id uuid
  userId varchar
  accountId int
  type varchar(50)
  status varchar(20) [default: 'pending']
  endpoint varchar(200)
  method varchar(10)
  statusCode int
  requestData jsonb
  responseData jsonb
  errorMessage text
  errorCode varchar(50)
  transactionId varchar(100)
  transactionUuid varchar(100)
  amount decimal(18,2)
  currency varchar(10)
  createdAt timestamptz
  metadata jsonb
  indexes {
    (userId, createdAt)
    (accountId, createdAt)
    (type, status)
  }
}

Table support_tickets {
  id uuid
  user_id varchar
  subject varchar(255)
  description text
  priority TicketPriorityEnum [default: 'MEDIUM']
  status TicketStatusEnum [default: 'OPEN']
  category TicketCategoryEnum [default: 'OTHER']
  assigned_to varchar
  source TicketSourceEnum [default: 'USER_PANEL']
  resolved_at timestamptz
  closed_at timestamptz
  first_response_at timestamptz
  satisfaction_score int
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

Table symbol {
  id uuid
  name varchar
  slug varchar
  market_type MarketTypeEnum [default: 'formal']
  payment_gateway_type varchar [default: 'up']
  pic_path varchar
  gain decimal(20,8)
  gain_type varchar [default: 'number']
  symbol_type varchar [default: 'fiat']
  unit_type varchar [default: 'number']
  has_payment_gateway boolean [default: 'false']
  is_active boolean [default: 'false']
  deposit_types jsonb [default: '[]']
  withdraw_types jsonb [default: '[]']
  deposit_gateways jsonb [default: '[]']
  withdraw_gateways jsonb [default: '[]']
  default_deposit_gateway varchar
  default_withdraw_gateway varchar
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
}

