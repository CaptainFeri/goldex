  credit_code varchar(50) [unique]
  amount decimal(20,8)
  status CreditStatusEnum [default: 'PENDING']
  has_call_margin boolean [default: 'false']
  call_margin_percent decimal(5,2)
  reminder_timer_hours int [default: 24]
