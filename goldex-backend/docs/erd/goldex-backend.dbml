  sell_commission decimal(10,2) [default: 0]
  trading_view_symbol varchar(50)
  min_buy decimal(20,8)
  max_buy decimal(20,8)
  min_sell decimal(20,8)
  max_sell decimal(20,8)
  decimals int [default: 2]
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz
