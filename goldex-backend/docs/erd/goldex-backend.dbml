  sell_volume decimal(24,8) [default: 0]
  net_volume decimal(24,8) [default: 0]
  buy_value decimal(24,2) [default: 0]
  sell_value decimal(24,2) [default: 0]
  net_value decimal(24,2) [default: 0]
