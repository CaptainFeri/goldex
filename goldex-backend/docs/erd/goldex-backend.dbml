  sell_price decimal(20,8)
  buy_gram_price decimal(20,8)
  sell_gram_price decimal(20,8)
  created_at timestamptz
  indexes {
    (pair_id, provider_key, provider_item_id)
  }
}

Table price_pairs {
  id uuid
  base_id uuid
  quote_id uuid
  price decimal(20,8)
  last_updated timestamp
  best_buy_price decimal(20,8)
  best_sell_price decimal(20,8)
  best_buy_gram_price decimal(20,8)
  best_sell_gram_price decimal(20,8)
  best_buy_provider varchar(50)
  best_sell_provider varchar(50)
  is_valid boolean [default: 'false']
