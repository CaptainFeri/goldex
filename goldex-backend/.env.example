GOLDEX_SWAGGER_USERNAME=test
GOLDEX_SWAGGER_PASSWORD=test

GOLDEX_PGADMIN_DEFAULT_EMAIL=test@test.com
GOLDEX_PGADMIN_DEFAULT_PASSWORD=test

GOLDEX_REDIS_HOST=redis-DEV

