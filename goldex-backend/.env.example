MAILGUN_FROM_EMAIL=

GOLDEX_PG_INTERNAL_PORT=80
GOLDEX_PG_EXTERNAL_PORT=8082

GOLDEX_APP_INTERNAL_PORT=3000
GOLDEX_APP_EXTERNAL_PORT=4041

GOLDEX_REDIS_INTERNAL_PORT=6379
GOLDEX_REDIS_EXTERNAL_PORT=6381

# Pricing-engine Redis (read-only) — source for provider price-history charts.
# In Docker reach it by the shared-network container name (pricing-engine-redis:6379);
# locally use localhost:6380.
GOLDEX_PRICING_REDIS_HOST=pricing-engine-redis
GOLDEX_PRICING_REDIS_PORT=6379
GOLDEX_PRICING_REDIS_DB=0

GOLDEX_AUTH_POSTGRES_INTERNAL_PORT=5432
GOLDEX_AUTH_POSTGRES_EXTERNAL_PORT=5434

GOLDEX_AUTH_SUPER_ADMIN_USERNAME=admin
GOLDEX_AUTH_SUPER_ADMIN_PASSWORD=@Aa123456

GOLDEX_BASE_URL=parszargar.com
GOLDEX_RESET_PASSWORD_ROUT=/auth/password-recovery

# NEW +
GOLDEX_ELASTIC_INTERNAL_PORT=9202
GOLDEX_ELASTIC_EXTERNAL_PORT=9203

GOLDEX_KIBANA_INTERNAL_PORT=5603
GOLDEX_KIBANA_EXTERNAL_PORT=5604

