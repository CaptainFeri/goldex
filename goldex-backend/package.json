    "@types/bcryptjs": "^3.0.0",
    "@types/decimal.js": "^0.0.32",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/kavenegar": "^1.1.3",
    "@types/minio": "^7.1.0",
    "@types/node": "^25.9.1",
